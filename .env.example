# Application
NODE_ENV=development
PORT=4000
APP_NAME=Adashi API
API_PREFIX=api/v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=adashi
DATABASE_SSL=false

# Authentication
JWT_ACCESS_SECRET=replace_with_secure_secret_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_secret_refresh
JWT_REFRESH_EXPIRES_IN=7d
AUTH_REQUIRE_VERIFICATION=false

# Redis (Phase 4+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (Phase 4+)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email (Phase 10)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Super Admin bootstrap (CLI only)
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_SECRET=

# Ops
LOG_LEVEL=debug
